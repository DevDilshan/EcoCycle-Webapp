# Copy this file to mobile/.env and fill in the lines marked [REPLACE].
# Every value below is a dummy. .env is gitignored.

# [REPLACE] Supabase project URL (Supabase > Settings > API).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# [REPLACE] Supabase app key (Supabase > Settings > API Keys). Either the
# Publishable key (sb_publishable_...) or the legacy anon key (eyJ...) works.
# Never put the sb_secret_... key here: this file is bundled into the app.
SUPABASE_ANON_KEY=sb_publishable_dummy-replace-me

# Public bucket for pickup photos (same as frontend VITE_SUPABASE_PICKUP_BUCKET). Keep as is.
SUPABASE_PICKUP_BUCKET=pickup-photos

# Backend API, must end in /api. This is the deployed one (Render). For a local
# backend use http://localhost:5051/api (web), http://127.0.0.1:5051/api (iOS)
# or http://10.0.2.2:5051/api (Android emulator).
API_BASE_URL=https://ecocycle-webapp.onrender.com/api
