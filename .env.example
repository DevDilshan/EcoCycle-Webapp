# Copy this file to .env and fill in your Supabase values
# Get them from: Supabase Dashboard → Project Settings → API / Database

# Database — use key=value format if your password has @ or $ characters
SUPABASE_CONNECTION_STRING=Host=db.YOUR_PROJECT_REF.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# Auth (backend)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret

# Auth (frontend)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
