# Database — key=value format (required when password contains @ or $)
SUPABASE_CONNECTION_STRING=Host=db.YOUR_PROJECT_REF.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Frontend → .NET API (no trailing slash). Empty locally = /api via Vite proxy.
VITE_API_BASE_URL=
# Comma-separated browser origins when VITE_API_BASE_URL points at Render (e.g. Vercel URL).
CORS_ALLOWED_ORIGINS=http://localhost:5173
GEMINI_API_KEY=your-api-key
GEMINI_MODEL=gemini-3.5-flash