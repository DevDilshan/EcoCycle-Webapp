# Copy this file to frontend/.env and fill in the lines marked [REPLACE].
# Every value below is a dummy. .env is gitignored.

# [REPLACE] Supabase project URL (Supabase > Settings > API).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# [REPLACE] Supabase browser key (Supabase > Settings > API Keys). Either the
# Publishable key (sb_publishable_...) or the legacy anon key (eyJ...) works.
# Never put the sb_secret_... key here: this file is shipped to the browser.
VITE_SUPABASE_ANON_KEY=sb_publishable_dummy-replace-me

# Public bucket for pickup photos (same as mobile SUPABASE_PICKUP_BUCKET). Keep as is.
VITE_SUPABASE_PICKUP_BUCKET=pickup-photos

# Backend origin without a trailing slash. Leave empty locally (Vite proxies /api).
# Production (Vercel): https://your-api.onrender.com
VITE_API_BASE_URL=
