# Copy this file to .env and fill in your own keys.
# .env is gitignored -- never commit a real key.

# Used by shared_llm.py for all agent LLM calls.
OPENAI_API_KEY=your-key-here

# Optional: only needed for image recognition in the Classifier Agent.
GEMINI_API_KEY=your-key-here

# Shared secret the C# backend must send as the X-Internal-Key header
# on every /run-pipeline and /route-approved-pickup call.
INTERNAL_API_KEY=your-internal-key-here
