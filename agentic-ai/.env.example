# Copy this file to .env and fill in your own keys.
# .env is gitignored -- never commit a real key.

# Used for every agent LLM call (shared_llm.py) and for photo recognition
# in the Classifier Agent (vision_llm.py).
OPENAI_API_KEY=your-key-here

# Optional: vision-capable OpenAI model used for photo recognition.
OPENAI_VISION_MODEL=gpt-4o-mini

# Shared secret the C# backend must send as the X-Internal-Key header
# on every /run-pipeline and /route-approved-pickup call.
INTERNAL_API_KEY=your-internal-key-here
