# Copy this file to agentic-ai/.env and fill in the lines marked [REPLACE].
# Every value below is a dummy. .env is gitignored -- never commit a real key.

# [REPLACE] OpenAI API key (platform.openai.com > API keys). Used for every agent
# LLM call (shared_llm.py) and for photo recognition (vision_llm.py).
OPENAI_API_KEY=sk-dummy-replace-me

# Vision-capable OpenAI model used for photo recognition. Keep as is.
OPENAI_VISION_MODEL=gpt-4o-mini

# [REPLACE] Shared secret the C# backend sends as the X-Internal-Key header. Any
# long random string; it must be the SAME value as INTERNAL_API_KEY in backend/.env.
INTERNAL_API_KEY=dummy-internal-key-replace-me

# Policy validator LLM pass (description vs category). Set false to use rules-only.
VALIDATOR_USE_LLM=true
