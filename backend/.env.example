# Copy this file to backend/.env and fill in the lines marked [REPLACE].
# Every value below is a dummy. .env is gitignored -- never commit a real secret.

# [REPLACE] Database connection (Supabase > Connect > Session pooler).
# Change only YOUR_REGION, YOUR_PROJECT_REF and YOUR_DB_PASSWORD; keep the rest.
#   - "Maximum Pool Size=10" matters: the pooler allows only 15 clients for the
#     whole team, and without the cap one busy backend takes them all and the
#     API starts returning 500s (EMAXCONNSESSION).
#   - The transaction pooler (port 6543) is not used: it needs
#     "No Reset On Close=true" to work with Npgsql at all, and it stopped
#     accepting connections for this project during testing.
SUPABASE_CONNECTION_STRING=Host=aws-0-YOUR_REGION.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Maximum Pool Size=10

# [REPLACE] Supabase project URL (Supabase > Settings > API). Used as the JWT issuer.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# [REPLACE] Legacy JWT secret (Supabase > Settings > JWT Keys). Required at startup.
# Logins signed with the new JWT signing keys are checked automatically through
# SUPABASE_URL, so the sb_publishable_/sb_secret_ API keys are NOT needed here.
SUPABASE_JWT_SECRET=dummy-jwt-secret-replace-me

# [REPLACE] Server-side admin key, required for account deletion (Supabase >
# Settings > API Keys). Either the Secret key (sb_secret_...) or the legacy
# service_role key works. SERVER-SIDE ONLY -- it grants full admin access, so
# never put it in the frontend or mobile .env.
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key-replace-me

# Python agent service. Keep as is for local runs.
# 127.0.0.1, not localhost: uvicorn listens on IPv4 only and Windows loses ~2s trying ::1 first
AGENT_SERVICE_URL=http://127.0.0.1:8000

# [REPLACE] Shared secret between this backend and the agent service. Any long
# random string; it must be the SAME value as INTERNAL_API_KEY in agentic-ai/.env.
INTERNAL_API_KEY=dummy-internal-key-replace-me

# Comma-separated browser origins allowed by CORS. Keep as is for local runs;
# in production add the deployed frontend URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
