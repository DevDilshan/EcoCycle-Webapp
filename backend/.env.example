# Copy this file to .env (in this backend folder) and fill in real values.
# .env is gitignored -- never commit a real secret.

# Database -- key=value format (required when the password contains @ or $)
SUPABASE_CONNECTION_STRING=Host=db.YOUR_PROJECT_REF.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# Supabase project URL (JWT issuer) and the secret used to validate tokens
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret

# Service-role key (Supabase dashboard -> Settings -> API -> service_role).
# SERVER-SIDE ONLY -- grants admin access; required for account deletion.
# Never expose this to the web or mobile client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Python agent service. INTERNAL_API_KEY must match agentic-ai/.env
AGENT_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=your-internal-key-here

# Comma-separated browser origins allowed by CORS (e.g. the Vercel URL in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173
